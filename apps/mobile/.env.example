# Copia este archivo como `.env` (no se versiona) y completa los valores del proyecto de Supabase.
# Sin `.env`, la app funciona solo en modo local.
# Solo claves publicables (sb_publishable_…). Nunca service_role ni sb_secret_.
EXPO_PUBLIC_ATHLETE_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
