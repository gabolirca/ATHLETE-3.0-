{
  "expo": {
    "name": "ATHLETE",
    "slug": "athlete",
    "scheme": "athlete3",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atheletsoftliirca.mobile",
      "appleTeamId": "P426A6G3TF",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "com.atheletsoftliirca.mobile",
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      "./plugins/withScriptSandboxingDisabled"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}