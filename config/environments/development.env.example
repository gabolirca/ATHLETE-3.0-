# ATHLETE 3.0 — ambiente: development
# Proyecto Supabase EXCLUSIVO de desarrollo (no compartido con testing ni producción).
# SOLO valores públicos. Copiar a apps/mobile/.env.development (ignorado por git) y rellenar.
# NUNCA poner aquí service_role, claves sb_secret_, contraseñas de base de datos ni tokens.
EXPO_PUBLIC_ATHLETE_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://<DEV_PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
