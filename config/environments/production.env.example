# ATHLETE 3.0 — ambiente: production
# Bloqueado en código hasta aprobar APPROVED_PRODUCTION_PROJECT_REF (packages/data/src/config/environment.ts).
# SOLO valores públicos. Copiar a apps/mobile/.env.production (ignorado por git) y rellenar.
# NUNCA poner aquí service_role, claves sb_secret_, contraseñas de base de datos ni tokens.
EXPO_PUBLIC_ATHLETE_ENV=production
EXPO_PUBLIC_SUPABASE_URL=https://<PROD_PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
