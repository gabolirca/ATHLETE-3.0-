# ATHLETE 3.0 — ambiente: testing
# Proyecto EXCLUSIVO para QA/E2E. Datos sintéticos; se puede reiniciar con aprobación.
# SOLO valores públicos. Copiar a apps/mobile/.env.testing (ignorado por git) y rellenar.
# NUNCA poner aquí service_role, claves sb_secret_, contraseñas de base de datos ni tokens.
EXPO_PUBLIC_ATHLETE_ENV=testing
EXPO_PUBLIC_SUPABASE_URL=https://<TEST_PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
