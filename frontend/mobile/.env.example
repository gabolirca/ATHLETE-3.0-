# Copia este archivo como `.env` (no se versiona) y completa los valores del proyecto de Supabase.
# Sin `.env`, la app funciona solo en modo local.
# Solo claves publicables (sb_publishable_…). Nunca service_role ni sb_secret_.
EXPO_PUBLIC_ATHLETE_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>

# Iniciar sesión con Google (Google Cloud → Credenciales → IDs de cliente OAuth). El "web" es el que va en Supabase.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Sign in with Apple (1 = activo). Requiere la cuenta de pago de Apple Developer.
EXPO_PUBLIC_APPLE_SIGNIN=0
